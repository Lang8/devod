# --- API (backend) ---
# Managed Postgres (Supabase/Neon) connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Long random string used to sign JWTs
JWT_SECRET=change-me
# Comma-separated allowed browser origins (the Vercel frontend URL)
CORS_ORIGINS=http://localhost:5173
JWT_TTL_MINUTES=60

# --- Frontend (Vite; build-time) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Offline pipeline only (never set on the API server) ---
ANTHROPIC_API_KEY=
